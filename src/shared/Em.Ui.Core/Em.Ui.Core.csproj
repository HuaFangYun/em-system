<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- See doc/engine/build.md#xml-docs -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Em</RootNamespace>
        <Description>Shared UI models and services for Em System clients.</Description>
        <Title>Em System UI core</Title>
        <PackageTags>em-system;ui;navigation;api-client</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Em.Libs\Em.Libs.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- Client log engine (ClientLogProvider); see doc/engine/engine-log.md. -->
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Em.Ui.Core.Tests" />
    </ItemGroup>

</Project>
